# ============================================
# BeenBite SaaS Platform - Environment Config
# ============================================

# General
NODE_ENV=development
LOG_LEVEL=debug

# API Gateway
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

# Auth Service
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001
JWT_ACCESS_SECRET=beenbite-access-secret-change-in-production-2024
JWT_REFRESH_SECRET=beenbite-refresh-secret-change-in-production-2024
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=12

# User Service
USER_SERVICE_PORT=3002
USER_SERVICE_URL=http://localhost:3002

# Company Service
COMPANY_SERVICE_PORT=3003
COMPANY_SERVICE_URL=http://localhost:3003

# Subscription Service
SUBSCRIPTION_SERVICE_PORT=3004
SUBSCRIPTION_SERVICE_URL=http://localhost:3004

# Payment Service
PAYMENT_SERVICE_PORT=3005
PAYMENT_SERVICE_URL=http://localhost:3005
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
PAYMENT_PROVIDER=stripe

# Reward Service
REWARD_SERVICE_PORT=3006
REWARD_SERVICE_URL=http://localhost:3006

# Master Data Service
MASTER_DATA_SERVICE_PORT=3007
MASTER_DATA_SERVICE_URL=http://localhost:3007

# Notification Service
NOTIFICATION_SERVICE_PORT=3008
NOTIFICATION_SERVICE_URL=http://localhost:3008
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_API_URL=https://api.whatsapp.com

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=beenbite_admin
DB_PASSWORD=beenbite_secure_password
DB_NAME_AUTH=beenbite_auth
DB_NAME_USER=beenbite_users
DB_NAME_COMPANY=beenbite_companies
DB_NAME_SUBSCRIPTION=beenbite_subscriptions
DB_NAME_PAYMENT=beenbite_payments
DB_NAME_REWARD=beenbite_rewards
DB_NAME_MASTER=beenbite_master
DB_NAME_NOTIFICATION=beenbite_notifications

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Frontend
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=BeenBite
