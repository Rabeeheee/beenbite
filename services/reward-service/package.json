    "@prisma/client": "^5.7.0", "ioredis": "^5.3.2", "amqplib": "^0.10.3",
    "zod": "^3.22.4", "winston": "^3.11.0", "dotenv": "^16.3.1",
    "http-status-codes": "^2.3.0", "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3", "prisma": "^5.7.0",
    "@types/express": "^4.17.21", "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7", "@types/node": "^20.10.0",
    "ts-node-dev": "^2.0.0", "ts-node": "^10.9.2",
    "jest": "^29.7.0", "ts-jest": "^29.1.1", "@types/jest": "^29.5.11"
  }
