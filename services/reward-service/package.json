{
  "name": "@beenbite/reward-service",
  "version": "1.0.0",
  "description": "Reward Service for BeenBite Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
