generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  pending
  verified
  rejected
  suspended
}

enum IndustryType {
  food_beverage
  retail
  healthcare
  education
  fitness
  beauty
  technology
  entertainment
  travel
  other
}

model Company {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  gstNumber   String        @unique @map("gst_number")
  industry    IndustryType
  email       String        @unique
  phone       String
  website     String?
  description String?
  logo        String?
  status      CompanyStatus @default(pending)
  adminUserId String        @map("admin_user_id")
  isActive    Boolean       @default(true) @map("is_active")

  address     CompanyAddress?
  theme       CompanyTheme?
  products    Product[]
  categories  Category[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([industry])
  @@map("companies")
}

model CompanyAddress {
  id        String  @id @default(uuid())
  companyId String  @unique @map("company_id")
  street    String
  city      String
  state     String
  zipCode   String  @map("zip_code")
  country   String  @default("India")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_addresses")
}

model CompanyTheme {
  id              String  @id @default(uuid())
  companyId       String  @unique @map("company_id")
  primaryColor    String  @default("#6366f1") @map("primary_color")
  secondaryColor  String  @default("#8b5cf6") @map("secondary_color")
  accentColor     String  @default("#ec4899") @map("accent_color")
  backgroundColor String  @default("#ffffff") @map("background_color")
  textColor       String  @default("#1f2937") @map("text_color")
  sidebarColor    String  @default("#1e1b4b") @map("sidebar_color")
  headerColor     String  @default("#ffffff") @map("header_color")
  fontFamily      String  @default("Inter") @map("font_family")
  borderRadius    String  @default("0.5rem") @map("border_radius")
  logoUrl         String? @map("logo_url")
  faviconUrl      String? @map("favicon_url")

  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_themes")
}

model Product {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  categoryId  String?  @map("category_id")
  name        String
  description String?
  price       Float
  images      String[] @default([])
  sku         String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([categoryId])
  @@map("products")
}

model Category {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  parentId    String?   @map("parent_id")
  icon        String?
  isActive    Boolean   @default(true) @map("is_active")

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      Category? @relation("CategoryChildren", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryChildren")
  products    Product[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("categories")
}
