{
  "name": "@beenbite/user-service",
  "version": "1.0.0",
  "description": "User Management Service for BeenBite Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
